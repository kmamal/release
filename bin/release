#!/usr/bin/env node

require('node:child_process').execSync('npm i --no-audit', { cwd: __dirname })

const args = (() => {
	const Argparse = require('argparse')

	const parser = new Argparse.ArgumentParser({
		description: "Release script for npm projects",
		add_help: true, // eslint-disable-line camelcase
	})

	parser.add_argument('-v', '--version', {
		action: 'version',
		version: `${parser.prog} v${require('../package.json').version}`,
		help: "Print version and exit",
	})

	parser.add_argument('-p', '--path', {
		help: "Path to the git repository",
		default: '.',
	})

	parser.add_argument('-t', '--type', {
		help: "Type of release",
		choices: [ 'major', 'minor', 'patch', 'premajor', 'preminor', 'prepatch', 'prerelease' ],
		default: 'patch',
	})

	parser.add_argument('-f', '--force', {
		help: "Commit and push everything",
		action: 'store_true',
	})

	parser.add_argument('-n', '--no-test', {
		help: "Don't do tests",
		action: 'store_true',
	})

	return parser.parse_args()
})()


const { release } = require('../src')

release(args.path, args.type, {
	force: args.force,
	noTest: args.no_test,
}).catch((error) => {
	console.error(error)
	process.exit(1)
})
